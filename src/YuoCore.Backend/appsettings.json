{
  "$schema": "../../schemas/appsettings.schema.json",
  "Game": {
    "TickRate": 10,
    "ShardCount": 4,
    "MaxTickConcurrency": 0,
    "ChannelCapacity": 262144,
    "BaseGoldPerSecond": 10,
    "BaseExpPerSecond": 5,
    "PersistEveryTicks": 50,
    "GatewayRequestsUseCommandQueue": true,
    "WorldEventsEnabled": true,
    "StateSyncAoiCellSize": 10,
    "StateSyncAoiRecoverRadiusCells": 1
  },
  "Storage": {
    "PostgresEnabled": false,
    "RedisEnabled": false,
    "DurableOutboxEnabled": false,
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=yuocore;Username=yuocore;Password=yuocore",
    "RedisConnectionString": "localhost:6379",
    "OutboxDirectory": "data/outbox",
    "PersistenceQueueCapacity": 65536
  },
  "Gateway": {
    "WebSocketPush": {
      "StateSyncMode": "PlayerStream",
      "PollIntervalMs": 50,
      "MaxQueuedMessages": 256,
      "SendTimeoutMs": 5000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
