{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YuoCore Idle Backend configuration",
  "type": "object",
  "properties": {
    "Game": {
      "type": "object",
      "properties": {
        "TickRate": { "type": "integer", "minimum": 1, "maximum": 60 },
        "ChannelCapacity": { "type": "integer", "minimum": 1024 },
        "BaseGoldPerSecond": { "type": "integer", "minimum": 0 },
        "BaseExpPerSecond": { "type": "integer", "minimum": 0 },
        "PersistEveryTicks": { "type": "integer", "minimum": 1 },
        "GatewayRequestsUseCommandQueue": { "type": "boolean" },
        "WorldEventsEnabled": { "type": "boolean" },
        "StateSyncAoiCellSize": { "type": "number", "exclusiveMinimum": 0 },
        "StateSyncAoiRecoverRadiusCells": { "type": "integer", "minimum": 0 }
      },
      "required": ["TickRate", "ChannelCapacity"]
    },
    "Storage": {
      "type": "object",
      "properties": {
        "PostgresEnabled": { "type": "boolean" },
        "RedisEnabled": { "type": "boolean" },
        "DurableOutboxEnabled": { "type": "boolean" },
        "PostgresConnectionString": { "type": "string", "minLength": 1 },
        "RedisConnectionString": { "type": "string", "minLength": 1 },
        "OutboxDirectory": { "type": "string", "minLength": 1 },
        "PersistenceQueueCapacity": { "type": "integer", "minimum": 1 }
      },
      "required": ["PostgresEnabled", "RedisEnabled", "DurableOutboxEnabled", "PostgresConnectionString", "RedisConnectionString", "OutboxDirectory", "PersistenceQueueCapacity"]
    },
    "Gateway": {
      "type": "object",
      "properties": {
        "WebSocketPush": {
          "type": "object",
          "properties": {
            "StateSyncMode": {
              "type": "string",
              "enum": ["PlayerStream", "AoiStream"]
            },
            "PollIntervalMs": { "type": "integer", "minimum": 1 },
            "MaxQueuedMessages": { "type": "integer", "minimum": 1 },
            "SendTimeoutMs": { "type": "integer", "minimum": 1 }
          },
          "required": ["StateSyncMode", "PollIntervalMs", "MaxQueuedMessages", "SendTimeoutMs"]
        }
      },
      "required": ["WebSocketPush"]
    },
    "Serilog": { "type": "object" },
    "AllowedHosts": { "type": "string" }
  },
  "required": ["Game", "Storage", "Gateway"]
}
